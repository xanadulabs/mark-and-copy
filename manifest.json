{
  "manifest_version": 3,
  "name": "Mark and Copy",
  "version": "1.4.6",
  "description": "Select part of the screen, mark it, and copy the picture.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mark-and-copy@xanadulabs.com",
      "strict_min_version": "128.0"
    }
  },
  "permissions": [
    "clipboardWrite",
    "nativeMessaging",
    "storage"
  ],
  "action": {
    "default_title": "Mark and Copy",
    "default_popup": "popup.html",
    "default_icon": {
      "32": "icons/32.png",
      "48": "icons/48.png",
      "96": "icons/96.png"
    }
  },
  "icons": {
    "32": "icons/32.png",
    "48": "icons/48.png",
    "96": "icons/96.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
